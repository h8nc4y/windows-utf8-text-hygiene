root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[scripts/private-marker-process.ps1]
charset = utf-8-bom

[scripts/scan-private-markers.ps1]
charset = utf-8-bom

[scripts/test-scan-private-markers.ps1]
charset = utf-8-bom

[scripts/validate-oss-readiness.ps1]
charset = utf-8-bom

[Makefile]
indent_style = tab
